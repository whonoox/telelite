# Get these from https://my.telegram.org (log in with your own Telegram account,
# then "API development tools" -> create an app)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Flask session cookie signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# How long a logged-in session stays valid without explicit logout
SESSION_TTL_HOURS=24

# Where the SQLite database file lives
DATABASE_PATH=data/telelite.db
